<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Custom WPF entry point for Velopack -->
    <StartupObject>RiftAssistant.App</StartupObject>

    <!-- Application identity -->
    <AssemblyName>RiftAssistant</AssemblyName>
    <RootNamespace>RiftAssistant</RootNamespace>
    <Product>RiftAssistant</Product>
    <Title>RiftAssistant</Title>
    <Authors>Kazım Karakaya</Authors>
    <Description>League of Legends client automation assistant.</Description>
	<ApplicationIcon>Assets\RiftAssistant_AppIcon.ico</ApplicationIcon>

    <!-- First beta release -->
	  <Version>0.9.0-beta.4</Version>
	  <AssemblyVersion>0.9.0.0</AssemblyVersion>
	  <FileVersion>0.9.0.4</FileVersion>
	  <InformationalVersion>0.9.0-beta.4</InformationalVersion>
  </PropertyGroup>

  <!--
    Velopack recommends App.xaml as Page when using a custom Main method,
    so WPF does not run its generated entry point before Velopack.
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <None Remove="Assets\RiftAssistant.ico" />
    <None Remove="Assets\RiftAssistant_AppIcon.ico" />
    <None Remove="Assets\RiftAssistant_AppIcon.png" />
    <Resource Include="Assets\RiftAssistant_AppIcon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RiftAssistant.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\RiftAssistant.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\RiftAssistant_AppIcon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
