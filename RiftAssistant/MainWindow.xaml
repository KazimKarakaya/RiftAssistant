<Window x:Class="RiftAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiftAssistant"
        Width="1220"
        Height="740"
        MinWidth="1080"
        MinHeight="670"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Topmost="True"
        Background="#0B0F14"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0B0F14"/>
        <SolidColorBrush x:Key="CardBrush" Color="#141A22"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#19212B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26313E"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#C89B3C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B98A8"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0F141B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#55D66B"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#5BA7FF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FeatureCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#202935"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
</Window.Resources>

    <Grid Background="{StaticResource PageBrush}"
          Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="RiftAssistant"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="League of Legends Client Automation"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border x:Name="LcuStatusBadge"
                    Grid.Column="1"
                    Background="#222831"
                    BorderBrush="#3A4654"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,7"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LcuStatusDot"
                             Width="8"
                             Height="8"
                             Fill="#8B98A8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="LcuStatusBadgeText"
                               Text="Bekleniyor"
                               Foreground="#C7D0DA"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Background="{StaticResource CardAltBrush}"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="#2B2417">

                    <TextBlock Text="●"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0">

                    <TextBlock Text="İstemci durumu"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"/>

                    <TextBlock x:Name="StatusText"
                               Text="League Client bekleniyor..."
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-COLUMN DASHBOARD / NO SCROLL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.78*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- AUTO ACCEPT -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="AUTO ACCEPT"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Otomatik kabul"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoAcceptCheckBox"
                                  Grid.Column="1"
                                  Content="Aktif"
                                  IsChecked="True"
                                  Checked="AutoAcceptCheckBox_Checked"
                                  Unchecked="AutoAcceptCheckBox_Unchecked"
                                  Style="{StaticResource FeatureCheckBoxStyle}"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource SubCardStyle}"
                            Margin="0,18,0,0">

                        <StackPanel>
                            <TextBlock Text="Kabul gecikmesi"
                                       Style="{StaticResource LabelStyle}"/>

                            <TextBlock Text="Ready Check başladıktan sonra beklenecek süre."
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,10"/>

                            <ComboBox x:Name="AutoAcceptDelayComboBox"
                                      SelectedIndex="5"
                                      SelectionChanged="AutoAcceptDelayComboBox_SelectionChanged"
                                      Style="{StaticResource InputComboBoxStyle}">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Margin="0,14,0,0">

                        <Border Background="#10161D"
                                BorderBrush="#253443"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10"
                                Margin="0,0,0,10">

                            <TextBlock x:Name="AutoAcceptStatusText"
                                       Text="Auto Accept hazır."
                                       Foreground="#B7C0CB"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Maç bulunduğunda seçtiğin gecikme sonunda otomatik kabul eder."
                                   Style="{StaticResource HintStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AUTO BAN -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="AUTO BAN"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Otomatik yasaklama"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="Öncelik: 1 → 2 → 3"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoBanCheckBox"
                                  Grid.Column="1"
                                  Content="Aktif"
                                  IsChecked="False"
                                  Checked="AutoBanCheckBox_Checked"
                                  Unchecked="AutoBanCheckBox_Unchecked"
                                  Style="{StaticResource FeatureCheckBoxStyle}"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource SubCardStyle}"
                            Margin="0,18,0,0">

                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="1. Ban tercihi"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Birinci öncelik"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,3,10,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        Background="#202935"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=PrimaryBanChampionComboBox}"
                                           Width="28"
                                           Height="28"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <ComboBox x:Name="PrimaryBanChampionComboBox"
                                          Height="38"
                                          Grid.Column="2"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="BanChampionComboBox_SelectionChanged"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="2. Ban tercihi"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="İkinci alternatif"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,3,10,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        Background="#202935"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=SecondaryBanChampionComboBox}"
                                           Width="28"
                                           Height="28"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <ComboBox x:Name="SecondaryBanChampionComboBox"
                                          Height="38"
                                          Grid.Column="2"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="BanChampionComboBox_SelectionChanged"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="3. Ban tercihi"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Son alternatif"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,3,10,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        Background="#202935"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=TertiaryBanChampionComboBox}"
                                           Width="28"
                                           Height="28"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <ComboBox x:Name="TertiaryBanChampionComboBox"
                                          Height="38"
                                          Grid.Column="2"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="BanChampionComboBox_SelectionChanged"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Ban zamanı"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="Süre bitimine kaç saniye kala?"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,3,10,0"/>
                        </StackPanel>

                        <ComboBox x:Name="AutoBanDelayComboBox"
                                  Grid.Column="1"
                                  SelectedIndex="4"
                                  SelectionChanged="AutoBanDelayComboBox_SelectionChanged"
                                  Style="{StaticResource InputComboBoxStyle}">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="#10161D"
                            BorderBrush="#253443"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10"
                            Margin="0,14,0,0">

                        <TextBlock x:Name="AutoBanStatusText"
                                   Text="Auto Ban hazır."
                                   Foreground="#B7C0CB"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- AUTO PICK -->
            <Border Grid.Column="4"
                    Style="{StaticResource CardStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="AUTO PICK"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Otomatik seçim"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,0"/>

                            <TextBlock Text="Hover + kilitleme • Öncelik: 1 → 2 → 3"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="AutoPickCheckBox"
                                  Grid.Column="1"
                                  Content="Aktif"
                                  IsChecked="False"
                                  Checked="AutoPickCheckBox_Checked"
                                  Unchecked="AutoPickCheckBox_Unchecked"
                                  Style="{StaticResource FeatureCheckBoxStyle}"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource SubCardStyle}"
                            Margin="0,18,0,0">

                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="1. Pick tercihi"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Birinci öncelik"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,3,10,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        Background="#202935"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=PrimaryPickChampionComboBox}"
                                           Width="28"
                                           Height="28"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <ComboBox x:Name="PrimaryPickChampionComboBox"
                                          Height="38"
                                          Grid.Column="2"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="PickChampionComboBox_SelectionChanged"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="2. Pick tercihi"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="İkinci alternatif"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,3,10,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        Background="#202935"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=SecondaryPickChampionComboBox}"
                                           Width="28"
                                           Height="28"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <ComboBox x:Name="SecondaryPickChampionComboBox"
                                          Height="38"
                                          Grid.Column="2"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="PickChampionComboBox_SelectionChanged"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="155"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="3. Pick tercihi"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="Son alternatif"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,3,10,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="7"
                                        ClipToBounds="True"
                                        Background="#202935"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">

                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=TertiaryPickChampionComboBox}"
                                           Width="28"
                                           Height="28"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <ComboBox x:Name="TertiaryPickChampionComboBox"
                                          Height="38"
                                          Grid.Column="2"
                                          IsTextSearchEnabled="True"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          TextSearch.TextPath="Name"
                                          SelectionChanged="PickChampionComboBox_SelectionChanged"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0">

                        <CheckBox x:Name="AutoHoverPickCheckBox"
                                  Content="Pick tercihini otomatik göster"
                                  IsChecked="True"
                                  Checked="AutoHoverPickCheckBox_Changed"
                                  Unchecked="AutoHoverPickCheckBox_Changed"
                                  Style="{StaticResource FeatureCheckBoxStyle}"
                                  Margin="0,0,0,8"/>
</StackPanel>

                    <Grid Grid.Row="3"
                          Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Pick zamanı"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="Süre bitimine kaç saniye kala?"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,3,10,0"/>
                        </StackPanel>

                        <ComboBox x:Name="AutoPickDelayComboBox"
                                  Grid.Column="1"
                                  SelectedIndex="4"
                                  SelectionChanged="AutoPickDelayComboBox_SelectionChanged"
                                  Style="{StaticResource InputComboBoxStyle}">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="4"
                            Background="#10161D"
                            BorderBrush="#253443"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10"
                            Margin="0,14,0,0">

                        <TextBlock x:Name="AutoPickStatusText"
                                   Text="Auto Pick hazır."
                                   Foreground="#B7C0CB"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Margin="0,14,0,0"
                Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="UYGULAMA"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Pencere, güncelleme ve uygulama bilgileri"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0"/>

                    <TextBlock Text="Güncellemeler açılışta otomatik kontrol edilir."
                               Style="{StaticResource HintStyle}"
                               Margin="0,3,0,0"/>

                    <TextBlock x:Name="VersionSignatureText"
                               Text="Developed by Kazım Karakaya with AI • v0.9.0-beta.1"
                               Foreground="#667382"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <CheckBox x:Name="TopMostCheckBox"
                              Content="Her zaman üstte"
                              IsChecked="True"
                              Checked="TopMostCheckBox_Checked"
                              Unchecked="TopMostCheckBox_Unchecked"
                              Style="{StaticResource FeatureCheckBoxStyle}"
                              Margin="0,0,16,0"/>

                    <Button x:Name="CheckUpdatesButton"
                            Content="Güncellemeleri kontrol et"
                            Width="180"
                            Click="CheckUpdatesButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Content="Hakkında"
                            Width="90"
                            Click="AboutButton_Click"
