                                <Button x:Name="CheckUpdatesButton"
                                        Content="Güncellemeleri kontrol et"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Click="CheckUpdatesButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ABOUT PAGE -->
                    <Grid x:Name="AboutPage"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Hakkında"
                                       Style="{StaticResource PageHeadingStyle}"/>
                            <TextBlock Text="RiftAssistant bilgileri"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                MaxWidth="700"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="54"
                                            Height="54"
                                            CornerRadius="14"
                                            Background="#241D12"
                                            BorderBrush="#5C4720"
                                            BorderThickness="1">
                                        <Image Source="/Assets/RiftAssistant.png"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,3,0,0">
                                        <TextBlock Text="RiftAssistant"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="League Client Automation Assistant"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="Developed by Kazım Karakaya with AI"
                                           Foreground="#A8B3BF"
                                           Margin="0,20,0,0"/>

                                <Button Content="Hakkında penceresini aç"
                                        Width="190"
                                        HorizontalAlignment="Left"
                                        Margin="0,18,0,0"
                                        Click="AboutButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
