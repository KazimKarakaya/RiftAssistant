<Window x:Class="RiftAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiftAssistant"
        Width="1180"
        Height="760"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Topmost="True"
        Background="#080D13"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#080D13"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0C121A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#101821"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#141E29"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#223040"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#C89B3C"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2A2215"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D99A8"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0C1219"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#58D66B"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#4E9BFF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
            <Setter Property="BorderBrush" Value="#1E2B39"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FeatureCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#17222E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#B6C0CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#B7C0CB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PageBrush}"
            BorderBrush="#1A2633"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLE BAR -->
            <Grid Grid.Row="0"
                  Background="#0A1017"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Border Width="30"
        Height="30"
        CornerRadius="7"
        ClipToBounds="True"
        Background="#10151D">

                        <Image Source="Assets/RiftAssistant_AppIcon.png"
       Width="30"
       Height="30"
       Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="RiftAssistant"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="PageTitleText"
                           Grid.Column="1"
                           Text="Dashboard"
                           Foreground="#7E8B9A"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="—"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="□"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MaximizeButton_Click"/>
                    <Button Content="✕"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#172330"
                        BorderThickness="0,1,1,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,10,0,0">
                            <Button x:Name="DashboardNavButton"
                                    Tag="Dashboard"
                                    Content="⌂   Dashboard"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"
                                    Background="#2A2417"
                                    BorderBrush="#624B20"
                                    Foreground="#E4B957"/>

                            <Button x:Name="AutoAcceptNavButton"
                                    Tag="AutoAccept"
                                    Content="✓   Auto Accept"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button x:Name="AutoBanNavButton"
                                    Tag="AutoBan"
                                    Content="⊘   Auto Ban"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button x:Name="AutoPickNavButton"
                                    Tag="AutoPick"
                                    Content="◇   Auto Pick"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button x:Name="ProfilesNavButton"
                                    Tag="Profiles"
                                    Content="◫   Profiller"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"
                                    Margin="10,15,10,3"/>

                            <Button x:Name="SettingsNavButton"
                                    Tag="Settings"
                                    Content="⚙   Ayarlar"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button x:Name="UpdatesNavButton"
                                    Tag="Updates"
                                    Content="↻   Güncellemeler"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"/>

                            <Button x:Name="AboutNavButton"
                                    Tag="About"
                                    Content="ⓘ   Hakkında"
                                    Click="NavigationButton_Click"
                                    Style="{StaticResource NavButtonStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="16,0,16,15">
                            <Separator Background="#1D2A37"
                                       Margin="0,0,0,12"/>

                            <TextBlock x:Name="VersionSignatureText"
                                       Text="Developed by Kazım Karakaya with AI • v0.9.0-beta.3"
                                       Foreground="#5E6B79"
                                       FontSize="9"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="RiftAssistant"
                                       Foreground="#354352"
                                       FontSize="9"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Grid.Column="1"
                      Margin="18">

                    <!-- DASHBOARD -->
                    <Grid x:Name="DashboardPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Dashboard"
                                       Style="{StaticResource PageHeadingStyle}"/>
                            <TextBlock Text="LCU bağlantısı ve otomasyonların genel durumu"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="LCU DURUMU"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock x:Name="StatusText"
                                               Text="League Client bekleniyor..."
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,7,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DashboardRoleProfileText"
                                               Text="Rol profili: bekleniyor"
                                               Foreground="#6D7B8B"
                                               FontSize="10"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border x:Name="LcuStatusBadge"
                                        Grid.Column="1"
                                        Background="#222831"
                                        BorderBrush="#3A4654"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="14,7"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LcuStatusDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#8B98A8"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LcuStatusBadgeText"
                                                   Text="Bekleniyor"
                                                   Foreground="#C7D0DA"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="58"
                                            Height="58"
                                            CornerRadius="29"
                                            BorderBrush="#C89B3C"
                                            BorderThickness="2"
                                            Background="#19170F">
                                        <TextBlock Text="✓"
                                                   FontSize="26"
                                                   Foreground="#E6B64C"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AUTO ACCEPT"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,15,0,0"/>
                                    <TextBlock x:Name="DashboardAutoAcceptStateText"
                                               Text="Aktif"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="Maç bulunduğunda otomatik kabul eder."
                                               Style="{StaticResource HintStyle}"
                                               TextAlignment="Center"
                                               Margin="8,14,8,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="58"
                                            Height="58"
                                            CornerRadius="29"
                                            BorderBrush="#9B5CFF"
                                            BorderThickness="2"
                                            Background="#191329">
                                        <TextBlock Text="⊘"
                                                   FontSize="25"
                                                   Foreground="#B985FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AUTO BAN"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,15,0,0"/>
                                    <TextBlock x:Name="DashboardAutoBanStateText"
                                               Text="Kapalı"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="1 → 2 → 3 önceliğine göre banlar."
                                               Style="{StaticResource HintStyle}"
                                               TextAlignment="Center"
                                               Margin="8,14,8,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="58"
                                            Height="58"
                                            CornerRadius="29"
                                            BorderBrush="#4A82FF"
                                            BorderThickness="2"
                                            Background="#111B2B">
                                        <TextBlock Text="◇"
                                                   FontSize="26"
                                                   Foreground="#5EA0FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AUTO PICK"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="Bold"
                                               Margin="0,15,0,0"/>
                                    <TextBlock x:Name="DashboardAutoPickStateText"
                                               Text="Kapalı"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="1 → 2 → 3 önceliğine göre pickler."
                                               Style="{StaticResource HintStyle}"
                                               TextAlignment="Center"
                                               Margin="8,14,8,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- AUTO ACCEPT PAGE -->
                    <Grid x:Name="AutoAcceptPage"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Auto Accept"
                                       Style="{StaticResource PageHeadingStyle}"/>
                            <TextBlock Text="Ready Check otomatik kabul ayarları"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Style="{StaticResource CardStyle}"
                                MaxWidth="760"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Otomatik kabul"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Maç bulunduğunda seçilen gecikme sonunda kabul eder."
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,4,20,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoAcceptCheckBox"
                                              Grid.Column="1"
                                              Content="Aktif"
                                              IsChecked="True"
                                              Checked="AutoAcceptCheckBox_Checked"
                                              Unchecked="AutoAcceptCheckBox_Unchecked"
                                              Style="{StaticResource FeatureCheckBoxStyle}"/>
                                </Grid>

                                <Border Style="{StaticResource SubCardStyle}"
                                        Margin="0,18,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Kabul gecikmesi"
                                                       Style="{StaticResource LabelStyle}"/>
                                            <TextBlock Text="Ready Check başladıktan sonra beklenecek saniye."
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,4,20,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="AutoAcceptDelayComboBox"
                                                  Grid.Column="1"
                                                  SelectedIndex="5"
                                                  SelectionChanged="AutoAcceptDelayComboBox_SelectionChanged"
                                                  Style="{StaticResource InputComboBoxStyle}">
                                            <ComboBoxItem Content="0"/>
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="5"/>
                                            <ComboBoxItem Content="6"/>
                                            <ComboBoxItem Content="7"/>
                                            <ComboBoxItem Content="8"/>
                                            <ComboBoxItem Content="9"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Background="#0D141C"
                                        BorderBrush="#203040"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12"
                                        Margin="0,14,0,0">
                                    <TextBlock x:Name="AutoAcceptStatusText"
                                               Text="Auto Accept hazır."
                                               Foreground="#B7C0CB"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- AUTO BAN PAGE -->
                    <Grid x:Name="AutoBanPage"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Auto Ban"
                                       Style="{StaticResource PageHeadingStyle}"/>
                            <TextBlock Text="Ban tercihleri ve otomatik kilitleme zamanı"
                                       Style="{StaticResource HintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource CardStyle}"
                                    MaxWidth="820"
                                    HorizontalAlignment="Left">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Otomatik yasaklama"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Öncelik sırası: 1 → 2 → 3"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoBanCheckBox"
                                                  Grid.Column="1"
                                                  Content="Aktif"
                                                  IsChecked="False"
                                                  Checked="AutoBanCheckBox_Checked"
                                                  Unchecked="AutoBanCheckBox_Unchecked"
                                                  Style="{StaticResource FeatureCheckBoxStyle}"/>
                                    </Grid>

                                    <Border Style="{StaticResource SubCardStyle}"
                                            Margin="0,18,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="230"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="1. Ban tercihi" Style="{StaticResource LabelStyle}"/>
                                                    <TextBlock Text="Birinci öncelik" Style="{StaticResource HintStyle}" Margin="0,3,10,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" ClipToBounds="True"
                                                        Background="#202935" VerticalAlignment="Center">
                                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=PrimaryBanChampionComboBox}"
                                                           Width="30" Height="30" Stretch="UniformToFill"/>
                                                </Border>
                                                <ComboBox x:Name="PrimaryBanChampionComboBox"
                                                          Grid.Column="2"
                                                          IsTextSearchEnabled="True"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          TextSearch.TextPath="Name"
                                                          SelectionChanged="BanChampionComboBox_SelectionChanged"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="230"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="2. Ban tercihi" Style="{StaticResource LabelStyle}"/>
                                                    <TextBlock Text="İkinci alternatif" Style="{StaticResource HintStyle}" Margin="0,3,10,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" ClipToBounds="True"
                                                        Background="#202935" VerticalAlignment="Center">
                                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=SecondaryBanChampionComboBox}"
                                                           Width="30" Height="30" Stretch="UniformToFill"/>
                                                </Border>
                                                <ComboBox x:Name="SecondaryBanChampionComboBox"
                                                          Grid.Column="2"
                                                          IsTextSearchEnabled="True"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          TextSearch.TextPath="Name"
                                                          SelectionChanged="BanChampionComboBox_SelectionChanged"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="230"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="3. Ban tercihi" Style="{StaticResource LabelStyle}"/>
                                                    <TextBlock Text="Son alternatif" Style="{StaticResource HintStyle}" Margin="0,3,10,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" ClipToBounds="True"
                                                        Background="#202935" VerticalAlignment="Center">
                                                    <Image Source="{Binding SelectedItem.IconUrl, ElementName=TertiaryBanChampionComboBox}"
                                                           Width="30" Height="30" Stretch="UniformToFill"/>
                                                </Border>
                                                <ComboBox x:Name="TertiaryBanChampionComboBox"
                                                          Grid.Column="2"
                                                          IsTextSearchEnabled="True"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          TextSearch.TextPath="Name"
                                                          SelectionChanged="BanChampionComboBox_SelectionChanged"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SubCardStyle}"
                                            Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Ban zamanı" Style="{StaticResource LabelStyle}"/>
                                                <TextBlock Text="Süre bitimine kaç saniye kala banlansın?"
                                                           Style="{StaticResource HintStyle}" Margin="0,3,10,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="AutoBanDelayComboBox"
                                                      Grid.Column="1"
                                                      SelectedIndex="4"
                                                      SelectionChanged="AutoBanDelayComboBox_SelectionChanged"
                                                      Style="{StaticResource InputComboBoxStyle}">
                                                <ComboBoxItem Content="1"/>
                                                <ComboBoxItem Content="2"/>
                                                <ComboBoxItem Content="3"/>
                                                <ComboBoxItem Content="4"/>
                                                <ComboBoxItem Content="5"/>
                                                <ComboBoxItem Content="6"/>
                                                <ComboBoxItem Content="7"/>
                                                <ComboBoxItem Content="8"/>
                                                <ComboBoxItem Content="9"/>
